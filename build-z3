#!/usr/bin/env bash
## Trigger the build-z3 GitHub Actions workflow for one or more Z3 versions.
## Usage: build-z3 <version> [<version> ...]
## Example: build-z3 4.8.12 4.16.0

if [ $# -eq 0 ]; then
    echo "Usage: build-z3 <version> [<version> ...]" >&2
    echo "Example: build-z3 4.8.12 4.16.0" >&2
    exit 1
fi

## Refuse to trigger a build if local commits on 'master' haven't been pushed
## to origin — the workflow would run the old code and silently ignore our fixes.
LOCAL=$(git -C "$(dirname "$0")" rev-parse master 2>/dev/null)
REMOTE=$(git -C "$(dirname "$0")" rev-parse origin/master 2>/dev/null)
if [ "$LOCAL" != "$REMOTE" ]; then
    echo "ERROR: local 'master' branch has unpushed commits (local=$LOCAL, origin=$REMOTE)." >&2
    echo "       Push first: cd $(dirname "$0") && git push origin master" >&2
    exit 1
fi

RES=0
for v in "$@" ; do
    printf "Triggering build for z3 %s ... " "$v"
    if gh workflow run build-z3.yml --repo OpenJML/Solvers --ref master --field z3_version="$v" > /dev/null; then
        echo "OK"
    else
        echo "FAILED" >&2
        RES=1
    fi
done
exit $RES
